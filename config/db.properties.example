# ============================================================================
# 文件：config/db.properties.example
# 用途：数据库连接配置模板。
#
# 【为什么需要这个文件】
#   任务说明书要求「不得提交密码、Token、私有密钥等敏感信息」。
#   如果直接把数据库密码写在 Java 代码里并提交到仓库，密码会永久留在
#   Git 历史中，任何能看到仓库的人都能拿到。
#   因此把连接信息放到配置文件里，真实配置（config/db.properties）
#   已加入 .gitignore，只提交本模板文件。
#
# 【使用方法】
#   1. 复制本文件为同目录下的 db.properties：
#        copy config\db.properties.example config\db.properties
#   2. 把下面 db.password 改成自己的 MySQL 密码
#   3. 重新运行程序（build.bat），控制台会提示已读取配置
#
# 【注意】db.properties 不要提交到仓库，也不要在群里发给别人。
# ============================================================================

# 数据库连接地址（默认连接本机 MySQL 的 campus_activity 库）
db.url=jdbc:mysql://localhost:3306/campus_activity?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true

# 数据库用户名
db.username=root

# 数据库密码（请改成自己的密码，不要提交本文件的这个副本）
db.password=改成你自己的MySQL密码
